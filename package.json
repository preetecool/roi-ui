{
  "name": "roiui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm registry:sync-and-index && next dev --turbopack",
    "build": "pnpm registry:sync-and-index && next build",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "registry:build": "pnpm registry:sync-and-index && shadcn build && node scripts/fix-registry-imports.ts && cp registry.json public/r/registry.json",
    "registry:index": "node scripts/build-registry-index.ts",
    "registry:sync": "node scripts/sync-block-shared-files.ts",
    "registry:sync-and-index": "pnpm registry:sync && pnpm registry:index",
    "test:registry": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@base-ui/utils": "^0.5.0",
    "@shikijs/rehype": "^3.23.0",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.17.9",
    "fumadocs-mdx": "^14.3.2",
    "geist": "^1.8.2",
    "lucide-react": "^0.525.0",
    "match-sorter": "^8.3.0",
    "motion": "^12.43.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.1",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.10.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.7.0",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agentation": "^3.1.2",
    "postcss": "^8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "ultracite": "^6.5.1"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
